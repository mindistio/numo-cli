{
  "name": "numo-cli",
  "version": "1.5.0",
  "description": "CLI and programmatic API for Numo ADHD planner — create, complete, and manage tasks from the terminal or AI agents",
  "type": "module",
  "bin": {
    "numo": "./dist/cli.cjs"
  },
  "files": [
    "dist/cli.cjs",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:cli",
    "build:cli": "node build.mjs",
    "dev": "tsx src/cli/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "numo",
    "adhd",
    "planner",
    "cli",
    "tasks",
    "productivity",
    "ai-agent",
    "automation",
    "task-management",
    "todo",
    "api"
  ],
  "author": "Numo <vital@numo.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindistio/numo-cli.git"
  },
  "homepage": "https://github.com/mindistio/numo-cli#readme",
  "bugs": {
    "url": "https://github.com/mindistio/numo-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "chrono-node": "^2.9.0",
    "commander": "^12.0.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.1"
  }
}
