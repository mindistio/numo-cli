{
  "name": "numo-cli",
  "version": "1.5.0",
  "description": "CLI and programmatic API for Numo ADHD planner — create, complete, and manage tasks from the terminal or AI agents",
  "type": "module",
  "bin": {
    "numo": "./dist/cli.cjs"
  },
  "files": [
    "dist/cli.cjs",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:cli",
    "build:cli": "node build.mjs",
    "dev": "tsx src/cli/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "numo",
    "adhd",
    "planner",
    "cli",
    "tasks",
    "productivity",
    "ai-agent",
    "automation",
    "task-management",
    "todo",
    "api"
  ],
  "author": "Mindist, Inc. <team@numo.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindistio/numo-cli.git"
  },
  "homepage": "https://numo.ai/cli",
  "bugs": {
    "email": "help@numo.ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "1.1.0",
    "chrono-node": "2.9.0",
    "commander": "12.1.0",
    "open": "10.2.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "esbuild": "0.25.12",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
