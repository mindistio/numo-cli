# Exact versions, never a range.
#
# Every dependency here is already pinned; this keeps it that way without anyone having
# to remember, because `npm i <pkg>` writes `^` by default and that is how the one slip
# in these repos happened (numo-api, three devDependencies, one release).
#
# It matters most here: this package is published, so a caret in `dependencies` is a
# range every INSTALLER resolves on their own machine, at their own moment — the build
# that shipped and the tree a user gets are then two different things.
#
# Affects only how `npm install <pkg>` WRITES new entries; `npm ci` and resolution are
# untouched. npm never publishes `.npmrc`, so this does not travel to consumers.
save-exact=true
